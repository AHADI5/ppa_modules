<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Actions -->
        <record id="department_manager_setup_action" model="ir.actions.act_window">
            <field name="name">Department's manager setup</field>
            <field name="res_model">hr.department</field>
            <field name="view_mode">tree</field>
            <field name="target">current</field>
            <field name="context">{}</field>
        </record>


        <record id="ppa_project_form_view" model="ir.ui.view">
            <field name="name">ppa.project.form.view</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="before">
                    <field name="department_id"/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="currency_id" invisible = '1' />
                    <field name="allocated_amount" widget="monetary" options = "{'currency_field': 'currency_id'}"/>
                </xpath>

                <!-- This tab will contain  all related Request For Quotation -->
                <xpath expr="//notebook" position="inside" >
                    <page string="Requests Sent"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
